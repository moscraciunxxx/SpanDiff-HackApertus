# Secrets and local config
.env
.env.*
!.env.example

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# Corrupt shard copies and last-block checkpoints are not a second submission.
# shard_00.jsonl and shard_mps.jsonl are still tracked. A commit has to
# remove them from the index. This ignore keeps them from coming back.
*.corrupt-backup
track_2a/data/shards/shard_layer8.jsonl
track_2a/data/shards/shard_mps_b.jsonl
track_2a/data/shards/shard_00.jsonl
track_2a/data/shards/shard_mps.jsonl
track_2a/data/shards/ids_cpu.txt
track_2a/data/shards/ids_mps.txt

# Dev-only SwissGov checkout and one-document probe output. Not the sealed split.
# Prediction checkpoints stay tracked so a restart can continue from git.
.swissgov/*
!.swissgov/data/
.swissgov/data/*
!.swissgov/data/evaluation/
.swissgov/data/evaluation/*
!.swissgov/data/evaluation/encoder_predictions/
.swissgov/data/evaluation/encoder_predictions/*
!.swissgov/data/evaluation/encoder_predictions/dev/
.swissgov/data/evaluation/encoder_predictions/dev/*
!.swissgov/data/evaluation/encoder_predictions/dev/SpanDiff_admin_*.jsonl.jsonl
track_2a/data/probe/

# Notes that stay on this machine. Not part of the public tree.
private/
